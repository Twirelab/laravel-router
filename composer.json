{
  "name": "twirelab/laravel-router",
  "description": "The new way of routing for the Laravel",
  "keywords": [
    "laravel",
    "routing",
    "router",
    "annotation",
    "twirelab"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^8.0 | ^9.0 | ^10.0 | ^11.0",
    "illuminate/routing": "^8.0 | ^9.0 | ^10.0 | ^11.0"
  },
  "require-dev": {
    "laravel/pint": "^1.10",
    "phpstan/phpstan": "^1.10",
    "pestphp/pest": "^2.0",
    "pestphp/pest-plugin-laravel": "^2.0",
    "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
    "mockery/mockery": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "Twirelab\\LaravelRouter\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Twirelab\\LaravelRouter\\LaravelRouterServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true,
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "phpstan": "phpstan analyse",
    "phpstan-baseline": "phpstan analyse --generate-baseline",
    "test": "pest",
    "test-coverage": "pest --coverage"
  },
  "support": {
    "issues": "https://github.com/Twirelab/laravel-router/issues",
    "source": "https://github.com/Twirelab/laravel-router"
  }
}
